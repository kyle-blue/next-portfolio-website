{
    "name": "kblue-portfolio",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "check": "pnpm typecheck && pnpm lint && pnpm build",
        "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "dependencies": {
        "@icons-pack/react-simple-icons": "^13.15.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.39.0",
        "next": "16.3.4",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2"
    }
}
